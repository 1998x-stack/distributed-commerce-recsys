# Mac host (substitute actual LAN IPs)
UBUNTU_A_IP=192.168.1.101
UBUNTU_B_IP=192.168.1.102
MAC_IP=192.168.1.103
DB_DRIVER=sqlite
SQLITE_PATH=/app/data/commerce.db
# Optional business switch: DB_DRIVER=postgresql
DATABASE_URL_POSTGRES=postgresql://commerce:replace-strong-password@192.168.1.101:5432/commerce
COMMERCE_PG_PASSWORD=replace-strong-password
OPENSEARCH_URL=http://192.168.1.101:9200
GORSE_URL=http://192.168.1.102:8087
API_INTERNAL_URL=http://api:8000
SESSION_SECRET=replace-with-random-64-character-secret
ADMIN_KEY=replace-with-random-admin-secret
GORSE_PG_PASSWORD=replace-with-strong-password
GORSE_DASHBOARD_PASSWORD=replace-with-strong-password

# Set to http://MAC_IP:3000,http://localhost:3000 for local browsing
ALLOWED_ORIGINS=http://192.168.1.103:3000,http://localhost:3000,http://127.0.0.1:3000
# Optional: only when using an authenticated Gorse REST service
GORSE_API_KEY=

# V1.4 process-local anonymous write rate limit (per visitor; IP has 8x budget).
# Use a shared Redis rate limiter before adding more API replicas.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=120

# V1.5: production API validates migrations applied by one-shot `migrate` service.
# For local non-Compose installs, run `alembic upgrade head` before enabling this.
SCHEMA_MODE=external
